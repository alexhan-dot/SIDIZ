{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-content-row.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width = section.settings.width
  assign media_side = section.settings.media_side
  assign has_media = false
  if section.settings.video != blank or section.settings.image != blank
    assign has_media = true
  endif
  comment
    The migration pipeline hands sections media as URL strings (KR CDN first,
    repointed to AU Files later), so the picker settings alone silently drop
    the media. URLs are the fallback; a picker choice still wins.
  endcomment
  if section.settings.video_url != blank or section.settings.image_url != blank
    assign has_media = true
  endif
  for block in section.blocks
    if block.type == 'media'
      assign has_media = true
    endif
  endfor
-%}
<script src="{{ 'sidiz-video.js' | asset_url }}" defer="defer"></script>

<section
  class="sidiz-row sidiz-row--{{ width }} sidiz-row--media-{{ media_side }} sidiz-row--text-{{ section.settings.text_align }}{% unless has_media %} sidiz-row--no-media{% endunless %}"
  style="
    --row-bg: {{ section.settings.background }};
    --row-fg: {{ section.settings.text_colour }};
    --row-pad-block: {{ section.settings.padding_block }}px;
  "
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
>
  <div class="sidiz-row__inner{% if width == 'contained' %} sidiz-container{% endif %}">
    {%- if has_media -%}
      <div class="sidiz-row__media">
        {%- if section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1600x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false
          }}
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 834px) 60vw, 100vw',
              widths: '480,760,1100,1500,1900,2400',
              alt: section.settings.image.alt
          }}
        {%- elsif section.settings.video_url != blank -%}
          {% render 'sidiz-video', url: section.settings.video_url, poster: section.settings.poster_url, alt: section.settings.alt, size: 'full' %}
        {%- elsif section.settings.image_url != blank -%}
          <img
            {% if section.settings.image_url_mobile != blank %}class="web"{% endif %}
            src="{{ section.settings.image_url }}?width=2400"
            sizes="(min-width: 834px) 60vw, 100vw"
            width="2400"
            height="1200"
            loading="lazy"
            alt="{{ section.settings.alt | escape }}"
          >
          {%- if section.settings.image_url_mobile != blank -%}
            <img
              class="mobile"
              src="{{ section.settings.image_url_mobile }}?width=1200"
              sizes="100vw"
              width="1200"
              height="1800"
              loading="lazy"
              alt="{{ section.settings.alt | escape }}"
            >
          {%- endif -%}
        {%- endif -%}

        {%- comment -%}
          Extra stacked media blocks. JSON templates cap at 25 sections, so
          back-to-back full-bleed image rows (the T60 AIR comparison tables)
          live in one row as blocks instead of one section each.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'media' -%}
            <img
              {% if block.settings.image_url_mobile != blank %}class="web"{% endif %}
              src="{{ block.settings.image_url }}?width=2400"
              sizes="(min-width: 834px) 60vw, 100vw"
              width="2400"
              height="1200"
              loading="lazy"
              alt="{{ block.settings.alt | escape }}"
              {{ block.shopify_attributes }}
            >
            {%- if block.settings.image_url_mobile != blank -%}
              <img
                class="mobile"
                src="{{ block.settings.image_url_mobile }}?width=1200"
                sizes="100vw"
                width="1200"
                height="1800"
                loading="lazy"
                alt="{{ block.settings.alt | escape }}"
              >
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="sidiz-row__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sidiz-row__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sidiz-row__heading sidiz-display">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="sidiz-row__text rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- assign fact_blocks = section.blocks | where: 'type', 'fact' -%}
      {%- if fact_blocks.size > 0 -%}
        <dl class="sidiz-row__facts">
          {%- for block in fact_blocks -%}
            <div class="sidiz-row__fact" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <a class="sidiz-row__cta" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SIDIZ content row",
  "tag": "section",
  "class": "sidiz-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "wide", "label": "Full bleed" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "contained", "label": "Contained" }
      ],
      "default": "wide",
      "info": "Full bleed matches the KR product_row_1_wide section."
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Media position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "above", "label": "Above text" },
        { "value": "background", "label": "Behind text" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Takes priority over the image when set."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Fallback when no image is picked. Used by the migration pipeline."
    },
    {
      "type": "text",
      "id": "image_url_mobile",
      "label": "Image URL (mobile)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Fallback when no video is picked."
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Video poster URL"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Media alt text"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets the sticky in-page nav jump to this row."
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_colour",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Spec fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    },
    {
      "type": "media",
      "name": "Stacked image",
      "settings": [
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "image_url_mobile", "label": "Image URL (mobile)" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIDIZ content row",
      "settings": {
        "width": "wide",
        "media_side": "left"
      }
    }
  ]
}
{% endschema %}
