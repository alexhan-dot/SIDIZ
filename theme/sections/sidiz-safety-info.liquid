{%- comment -%}
  Port of the KR `product_information` section — safety notes for using the
  chair, each with an illustration.

  KR structure:
    section.section-product-before-purchasing.section-product-information
      > .container > .wrapper
          > .wrapper--header > h2.title
          > .wrapper--body > .information-list
              > .information-item
                  > .item--image > img
                  > .item--text--wrap > .item--text
                      > h3.title + .description.rich-text-area > .size-13

  KR also pushes each item into window.__faqBlocks so the page's FAQ schema
  picks it up. That is done the same way here — a safety warning is exactly the
  kind of thing people ask an assistant about, so it belongs in the FAQ data.
{%- endcomment -%}

{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'section-product-information.css' | asset_url | stylesheet_tag }}

{%- assign items = section.blocks | where: 'type', 'note' -%}

<div class="container">
  <div class="wrapper">
    {%- if section.settings.heading != blank -%}
      <div class="wrapper--header">
        <h2 class="title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="wrapper--body">
      <div class="information-list">
        {%- for block in items -%}
          <div class="information-item" {{ block.shopify_attributes }}>
            <div class="item--image">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', widths: '450,900', alt: block.settings.alt
                }}
              {%- elsif block.settings.image_url != blank -%}
                <img
                  src="{{ block.settings.image_url }}?width=900"
                  srcset="{{ block.settings.image_url }}?width=450 450w, {{ block.settings.image_url }}?width=900 900w"
                  sizes="(min-width: 1024px) 30vw, 90vw"
                  width="900"
                  height="675"
                  alt="{{ block.settings.alt | escape }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- endif -%}
            </div>

            <div class="item--text--wrap" style="display:flex;">
              <div class="item--text">
                {%- if block.settings.title != blank -%}
                  <h3 class="title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="description rich-text-area">
                    <div class="size-13">{{ block.settings.body }}</div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- if items.size > 0 -%}
  <script>
    (function () {
      window.__faqBlocks = Array.isArray(window.__faqBlocks) ? window.__faqBlocks : [];
      window.__faqBlocks.push(
        {%- for block in items -%}
          {
            name: {{ block.settings.title | strip_html | json }},
            answer: {{ block.settings.body | strip_html | strip_newlines | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      );
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SIDIZ safety notes",
  "tag": "section",
  "class": "section-product-before-purchasing section-product-information",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Using your chair safely" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Safety note",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [{ "name": "SIDIZ safety notes", "blocks": [{ "type": "note" }] }]
}
{% endschema %}
