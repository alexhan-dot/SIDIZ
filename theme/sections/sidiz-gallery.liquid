{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KR product_view_horizontal / product_view_vertical — a scrolling media strip.
  Horizontal on desktop, stacked on mobile so the page never scrolls sideways.
{%- endcomment -%}

<section
  class="sidiz-gallery sidiz-gallery--{{ section.settings.direction }} sidiz-section"
  style="--gal-bg: {{ section.settings.background }}; --gal-fg: {{ section.settings.text_colour }};"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
>
  {%- if section.settings.heading != blank or section.settings.body != blank -%}
    <div class="sidiz-container sidiz-gallery__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sidiz-gallery__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sidiz-gallery__heading sidiz-display">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="sidiz-gallery__intro rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="sidiz-gallery__track">
    {%- for block in section.blocks -%}
      <figure class="sidiz-gallery__item" {{ block.shopify_attributes }}>
        {%- liquid
          # The pipeline writes plain image URLs as image_url; media_url stays
          # the primary so existing blocks keep working.
          assign item_url = block.settings.media_url | default: block.settings.image_url
        -%}
        {% render 'sidiz-media',
          image: block.settings.image,
          url: item_url,
          poster: block.settings.poster_url,
          alt: block.settings.alt,
          ratio: section.settings.ratio,
          sizes: '(min-width: 834px) 70vw, 90vw'
        %}
        {%- if block.settings.caption != blank -%}
          <figcaption class="sidiz-gallery__caption">{{ block.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SIDIZ gallery",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "horizontal", "label": "Horizontal scroll" },
        { "value": "vertical", "label": "Vertical stack" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Media ratio",
      "options": [
        { "value": "16/9", "label": "16:9" },
        { "value": "3/2", "label": "3:2" },
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "4:5" }
      ],
      "default": "16/9"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Intro" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_colour", "label": "Text", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Media",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "media_url", "label": "Media URL" },
        { "type": "text", "id": "image_url", "label": "Image URL", "info": "Alias for Media URL; used by the migration pipeline." },
        { "type": "text", "id": "poster_url", "label": "Video poster URL" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "SIDIZ gallery", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
