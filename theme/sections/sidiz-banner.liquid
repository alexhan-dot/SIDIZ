{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sidiz-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign is_carousel = false
  if slides.size > 1
    assign is_carousel = true
  endif
-%}

<section
  class="sidiz-banner sidiz-banner--{{ section.settings.height }}{% if section.settings.contained %} sidiz-container{% endif %}"
  {% if is_carousel %}
    data-sidiz-carousel
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
  {% endif %}
>
  <div class="sidiz-banner__track">
    {%- for block in slides -%}
      <article
        class="sidiz-banner__slide sidiz-banner__slide--align-{{ block.settings.align }}"
        style="--slide-fg: {{ block.settings.text_colour }}; --slide-scrim: {{ block.settings.scrim }};"
        {{ block.shopify_attributes }}
      >
        <div class="sidiz-banner__media">
          {%- if block.settings.video != blank -%}
            {{
              block.settings.video
              | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false
            }}
          {%- else -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 767px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 1200 }}"
                >
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: forloop.first | default: 'lazy',
                    fetchpriority: 'high',
                    sizes: '100vw',
                    widths: '760,1100,1500,1900,2400',
                    alt: block.settings.image.alt
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  sizes: '100vw',
                  widths: '760,1100,1500,1900,2400',
                  alt: block.settings.image.alt
              }}
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if block.settings.heading != blank or block.settings.body != blank -%}
          <div class="sidiz-banner__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="sidiz-banner__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="sidiz-banner__heading sidiz-display">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="sidiz-banner__body">{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
              <a class="sidiz-banner__cta" href="{{ block.settings.cta_link }}">
                {{ block.settings.cta_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>

  {%- if is_carousel -%}
    <div class="sidiz-banner__nav" role="tablist" aria-label="{{ 'general.slider.name' | t }}">
      {%- for block in slides -%}
        <button
          class="sidiz-banner__dot"
          type="button"
          role="tab"
          aria-label="{{ forloop.index }}"
          data-index="{{ forloop.index0 }}"
          {% if forloop.first %}aria-selected="true"{% endif %}
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "SIDIZ banner",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "hero", "label": "Hero (full viewport)" },
        { "value": "tall", "label": "Tall" },
        { "value": "medium", "label": "Medium" },
        { "value": "short", "label": "Short" }
      ],
      "default": "tall"
    },
    {
      "type": "checkbox",
      "id": "contained",
      "label": "Constrain to container width",
      "default": false
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-advance slides",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional. Used below 768px."
        },
        { "type": "video", "id": "video", "label": "Video", "info": "Takes priority over the image." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "body", "label": "Body" },
        { "type": "text", "id": "cta_label", "label": "Button label" },
        { "type": "url", "id": "cta_link", "label": "Button link" },
        {
          "type": "select",
          "id": "align",
          "label": "Content position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "centre", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "color", "id": "text_colour", "label": "Text colour", "default": "#ffffff" },
        {
          "type": "color",
          "id": "scrim",
          "label": "Scrim",
          "default": "rgba(0,0,0,0.25)",
          "info": "Darkens the image so text stays legible."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIDIZ banner",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
