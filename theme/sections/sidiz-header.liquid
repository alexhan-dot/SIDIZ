{%- comment -%}
  SIDIZ header — fixed over the page, text-only contrast switching.

  Rebuilt after two wrong turns:

  1. Stacking two rows that pushed the page down. The header floats over the
     content instead.
  2. mix-blend-mode: difference. It blends per channel, so a coloured backdrop
     gives coloured text — green nav over a red chair — instead of the clean
     black or white this design calls for. It also inverted the logo and icons
     as a side effect rather than by intent.

  Now: a fixed bar with a light backdrop blur so the menu reads as its own
  region, and text that switches between black and white. Sections declare what
  sits behind the header with data-header-scheme="dark|light"; sidiz-header.js
  watches which declaring section crosses the bar and toggles the class.
  Anything that declares nothing counts as light.
{%- endcomment -%}

{{ 'sidiz-root-variables.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sidiz-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign utility = section.blocks | where: 'type', 'utility'
  assign menus = section.blocks | where: 'type', 'menu'
-%}

<div class="sidiz-header header--on-light" data-sidiz-header>
  <div class="sidiz-header__inner">
    <a class="sidiz-header__logo" href="{{ routes.root_url }}" title="{{ shop.name | escape }}">
      <span class="logo-img">
        <img src="{{ 'sidiz_symbol.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="24" height="24">
      </span>
    </a>

    {%- if menus.size > 0 -%}
      <nav aria-label="{{ 'sections.header.menu' | t | default: 'Main' }}">
        <ul class="sidiz-header__nav">
          {%- for block in menus -%}
            {%- liquid
              assign handle = block.settings.label | handleize
              assign rows = block.settings.columns | newline_to_br | split: '<br />'
            -%}
            <li {{ block.shopify_attributes }}>
              <a
                class="menu-link"
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}href="#" aria-haspopup="true"{% endif %}
              >
                <span class="gnb-title">{{ block.settings.label }}</span>
              </a>

              {%- if block.settings.columns != blank -%}
                <div class="sidiz-header__submenu" id="submenu-{{ handle }}">
                  {%- if block.settings.column_title != blank -%}
                    <div class="submenu--group-title">{{ block.settings.column_title }}</div>
                  {%- endif -%}
                  {%- for row in rows -%}
                    {%- assign parts = row | strip | split: '|' -%}
                    {%- if parts.size > 1 -%}
                      <a href="{{ parts[1] | strip }}">{{ parts[0] | strip }}</a>
                    {%- elsif parts[0] != blank -%}
                      <div class="submenu--group-title">{{ parts[0] | strip }}</div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if utility.size > 0 -%}
      <div class="sidiz-header__utility">
        {%- for block in utility -%}
          <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            <span class="header-upper-menu">{{ block.settings.label }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="sidiz-header__icons">
      <a href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
        <img src="{{ 'icon-search-line-bk.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy">
      </a>
      <a href="{{ routes.cart_url }}" aria-label="{{ 'sections.header.cart' | t }}">
        <img src="{{ 'icon-bookmark-line-bk-28.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy">
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SIDIZ header",
  "tag": "header",
  "class": "shopify-section-group-header-group",
  "settings": [
    {
      "type": "paragraph",
      "content": "The header floats over the page. Its text turns white over sections set to a dark header scheme and black everywhere else. Submenu links are one per line, as 'Label | /url'; a line with no pipe becomes a group heading."
    }
  ],
  "blocks": [
    {
      "type": "utility",
      "name": "Utility link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave blank if this item only opens a submenu." },
        { "type": "text", "id": "column_title", "label": "Submenu heading" },
        { "type": "textarea", "id": "columns", "label": "Submenu links", "info": "One per line: Label | /url" }
      ]
    }
  ],
  "presets": [{ "name": "SIDIZ header", "blocks": [{ "type": "menu" }, { "type": "menu" }] }]
}
{% endschema %}
