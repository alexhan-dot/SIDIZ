{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KR product_spec — 제품 사이즈. Dimension drawings plus a specification table.
  Rendered as a real <table>, not an image, so the numbers are searchable,
  translatable and readable by assistive tech.
{%- endcomment -%}

<section
  class="sidiz-spec sidiz-section"
  style="--spec-bg: {{ section.settings.background }};"
  id="{{ section.settings.anchor_id | default: 'specifications' | handleize }}"
>
  <div class="sidiz-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="sidiz-spec__heading sidiz-display">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="sidiz-spec__layout">
      {%- assign drawings = section.blocks | where: 'type', 'drawing' -%}
      {%- if drawings.size > 0 -%}
        <div class="sidiz-spec__drawings">
          {%- for block in drawings -%}
            {% render 'sidiz-media',
              image: block.settings.image,
              url: block.settings.media_url,
              alt: block.settings.alt,
              sizes: '(min-width: 834px) 50vw, 100vw',
              class: 'sidiz-spec__drawing'
            %}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign rows = section.blocks | where: 'type', 'row' -%}
      {%- if rows.size > 0 -%}
        <div class="sidiz-spec__tablewrap">
          <table class="sidiz-spec__table">
            <caption class="visually-hidden">
              {{ section.settings.heading | default: 'Specifications' }}
            </caption>
            <tbody>
              {%- for block in rows -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ block.settings.label }}</th>
                  <td>{{ block.settings.value }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="sidiz-spec__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SIDIZ specifications",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "specifications" },
    { "type": "text", "id": "note", "label": "Footnote" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    {
      "type": "paragraph",
      "content": "Use metric units throughout — mm, cm and kg. Never inches or pounds."
    }
  ],
  "blocks": [
    {
      "type": "drawing",
      "name": "Dimension drawing",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "media_url", "label": "Media URL" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    },
    {
      "type": "row",
      "name": "Specification",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIDIZ specifications",
      "blocks": [{ "type": "drawing" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
