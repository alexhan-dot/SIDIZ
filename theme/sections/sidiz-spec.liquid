{%- comment -%}
  Port of the KR `product_spec` section — dimension drawings side by side above
  the key figures and the measurement caveats. My earlier version put a spec
  table beside a single drawing, which is not the KR layout.

  KR structure:
    section.section-product-spec
      > .container > .wrapper
          > .wrapper--header > h2.title
          > .wrapper--body > .spec-swiper.swiper > .swiper-wrapper
              > .swiper-slide
                  > .slide-media--wrap > .slide--media > img   (one per drawing)
                  > .slide-info--wrap > .description-1 + .description-2
{%- endcomment -%}

{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'section-product-spec.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'section-product-spec.js' | asset_url }}" defer="defer"></script>

<div class="container">
  <div class="wrapper">
    {%- if section.settings.heading != blank -%}
      <div class="wrapper--header">
        <h2 class="title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="wrapper--body">
      <div class="spec-swiper swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="slide-media--wrap">
              {%- for block in section.blocks -%}
                {%- if block.type == 'drawing' -%}
                  <div class="slide--media" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag: loading: 'lazy', widths: '600,900,1200', alt: block.settings.alt
                      }}
                    {%- elsif block.settings.image_url != blank -%}
                      <img
                        src="{{ block.settings.image_url }}?width=1200"
                        srcset="{{ block.settings.image_url }}?width=600 600w, {{ block.settings.image_url }}?width=1200 1200w"
                        sizes="(min-width: 1024px) 40vw, 90vw"
                        width="1200"
                        height="1200"
                        alt="{{ block.settings.alt | escape }}"
                        loading="lazy"
                        decoding="async"
                      >
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="slide-info--wrap">
              {%- if section.settings.figures != blank -%}
                <div class="description-1">{{ section.settings.figures }}</div>
              {%- endif -%}
              {%- if section.settings.caveats != blank -%}
                <div class="description-2">{{ section.settings.caveats }}</div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SIDIZ specifications",
  "tag": "section",
  "class": "section-product-spec",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "T90 dimensions" },
    {
      "type": "html",
      "id": "figures",
      "label": "Key figures",
      "info": "Metric only — kg and mm. Never pounds or inches."
    },
    { "type": "html", "id": "caveats", "label": "Measurement notes" }
  ],
  "blocks": [
    {
      "type": "drawing",
      "name": "Dimension drawing",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    { "name": "SIDIZ specifications", "blocks": [{ "type": "drawing" }, { "type": "drawing" }] }
  ]
}
{% endschema %}
