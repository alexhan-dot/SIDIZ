{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KR product_warranty — warranty plus product registration.

  Australian Consumer Law requires that any voluntary warranty against defects
  is accompanied by the mandatory consumer guarantees statement, and that the
  warranty is not presented as limiting those guarantees. The ACL text is a
  separate, always-rendered block rather than an editable setting so it cannot
  be deleted from a product page by mistake.
{%- endcomment -%}

<section
  class="sidiz-warranty sidiz-section"
  style="--war-bg: {{ section.settings.background }}; --war-fg: {{ section.settings.text_colour }};"
  id="{{ section.settings.anchor_id | default: 'warranty' | handleize }}"
>
  {%- if section.settings.image != blank or section.settings.media_url != blank -%}
    {% render 'sidiz-media',
      image: section.settings.image,
      url: section.settings.media_url,
      alt: section.settings.alt,
      sizes: '100vw',
      class: 'sidiz-warranty__bg'
    %}
  {%- endif -%}

  <div class="sidiz-container sidiz-warranty__inner">
    {%- if section.settings.term != blank -%}
      <p class="sidiz-warranty__term">{{ section.settings.term }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="sidiz-warranty__heading sidiz-display">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="sidiz-warranty__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    <div class="sidiz-warranty__actions">
      {%- if section.settings.register_link != blank -%}
        <a class="sidiz-btn sidiz-btn--solid" href="{{ section.settings.register_link }}">
          {{ section.settings.register_label | default: 'Register your product' }}
        </a>
      {%- endif -%}
      {%- if section.settings.policy_link != blank -%}
        <a class="sidiz-btn sidiz-btn--ghost" href="{{ section.settings.policy_link }}">
          {{ section.settings.policy_label | default: 'Warranty terms' }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_acl -%}
      <div class="sidiz-warranty__acl" role="note">
        <h3 class="sidiz-warranty__acl-heading">Your rights under the Australian Consumer Law</h3>
        <p>
          Our goods come with guarantees that cannot be excluded under the Australian Consumer Law.
          You are entitled to a replacement or refund for a major failure and compensation for any
          other reasonably foreseeable loss or damage. You are also entitled to have the goods
          repaired or replaced if the goods fail to be of acceptable quality and the failure does
          not amount to a major failure.
        </p>
        <p>
          This warranty is in addition to, and does not limit, exclude or modify, the rights and
          remedies available to you under the Australian Consumer Law.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SIDIZ warranty",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "term", "label": "Term badge", "default": "15 years" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "media_url", "label": "Background media URL" },
    { "type": "text", "id": "alt", "label": "Alt text" },
    { "type": "header", "content": "Product registration" },
    { "type": "text", "id": "register_label", "label": "Register button label", "default": "Register your product" },
    { "type": "url", "id": "register_link", "label": "Register page" },
    { "type": "text", "id": "policy_label", "label": "Policy link label", "default": "Warranty terms" },
    { "type": "url", "id": "policy_link", "label": "Warranty policy page" },
    { "type": "header", "content": "Compliance" },
    {
      "type": "checkbox",
      "id": "show_acl",
      "label": "Show the Australian Consumer Law statement",
      "default": true,
      "info": "Required by law wherever a warranty against defects is advertised. Leave this on."
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "warranty" },
    { "type": "color", "id": "background", "label": "Background", "default": "#242526" },
    { "type": "color", "id": "text_colour", "label": "Text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "SIDIZ warranty" }]
}
{% endschema %}
