{%- comment -%}
  Port of the KR `product_wb_banner` section — a full-bleed video or image with
  the tag / title / description block positioned over it.

  KR structure:
    .container > .container--body.align-<h>.align-vertical-<v>
                   > .wrapper--background > video.web + video.mobile
                   > .wrapper--text > .tag + .title + .description.rich-text-area
{%- endcomment -%}

{{ 'theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sidiz-video.js' | asset_url }}" defer="defer"></script>
{{ 'section-product-wb.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-au-overrides.css' | asset_url | stylesheet_tag }}

{%- assign scope = 'section-' | append: section.id -%}

<div class="container {{ scope }}" data-header-scheme="{{ section.settings.header_scheme }}">
  <div class="container--body align-{{ section.settings.align }} align-vertical-{{ section.settings.align_vertical }}">
    <div class="wrapper--background">
      {%- if section.settings.video_url != blank -%}
        {% render 'sidiz-video', url: section.settings.video_url, poster: section.settings.poster_url, alt: section.settings.alt, classes: 'web', size: 'full' %}
      {%- elsif section.settings.image_url != blank -%}
        <img
          class="web"
          src="{{ section.settings.image_url }}?width=2000"
          sizes="100vw"
          width="2000"
          height="1125"
          alt="{{ section.settings.alt | escape }}"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}

      {%- if section.settings.video_url_mobile != blank -%}
        {% render 'sidiz-video', url: section.settings.video_url_mobile, poster: section.settings.poster_url_mobile, alt: section.settings.alt, classes: 'mobile', size: 'full' %}
      {%- elsif section.settings.image_url_mobile != blank -%}
        <img
          class="mobile"
          src="{{ section.settings.image_url_mobile }}?width=1200"
          sizes="100vw"
          width="1200"
          height="2133"
          alt="{{ section.settings.alt | escape }}"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
    </div>

    <div class="wrapper--text">
      {%- if section.settings.tag != blank -%}
        <div class="tag">{{ section.settings.tag }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <div class="title">{{ section.settings.heading }}</div>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="description rich-text-area">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    KR sets these per section, not in the shared stylesheet. On T90 the tilt
    banner runs tag #000000 on #eaedf0, title #ffffff, description #a4aab0.
  {%- endcomment -%}
  <style data-shopify>
    .{{ scope }} .container--body .wrapper--text .tag {
      color: {{ section.settings.tag_colour }};
      background-color: {{ section.settings.tag_background }};
    }
    .{{ scope }} .container--body .wrapper--text .title { color: {{ section.settings.title_colour }}; }
    .{{ scope }} .container--body .wrapper--text .description { color: {{ section.settings.description_colour }}; }
    @media screen and (max-width: 1023px) {
      .{{ scope }} .container--body .wrapper--text .tag {
        color: {{ section.settings.tag_colour }};
        background-color: {{ section.settings.tag_background }};
      }
      .{{ scope }} .container--body .wrapper--text .title { color: {{ section.settings.title_colour }}; }
      .{{ scope }} .container--body .wrapper--text .description { color: {{ section.settings.description_colour }}; }
    }
  </style>
</div>

{% schema %}
{
  "name": "SIDIZ WB banner",
  "tag": "section",
  "class": "section-product-wb-banner",
  "settings": [
    {
      "type": "select",
      "id": "header_scheme",
      "label": "Header text over this section",
      "options": [
        { "value": "light", "label": "Black (light background)" },
        { "value": "dark", "label": "White (dark background)" }
      ],
      "default": "dark",
      "info": "Sets which colour the floating header switches to while this section is under it."
    },
    { "type": "text", "id": "tag", "label": "Tag" },
    { "type": "html", "id": "heading", "label": "Heading", "info": "Use <br> for line breaks." },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "align",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "align_vertical",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    { "type": "color", "id": "tag_colour", "label": "Tag text colour", "default": "#000000" },
    { "type": "color", "id": "tag_background", "label": "Tag background", "default": "#eaedf0" },
    { "type": "color", "id": "title_colour", "label": "Title colour", "default": "#ffffff" },
    { "type": "color", "id": "description_colour", "label": "Description colour", "default": "#a4aab0" },
    { "type": "header", "content": "Media" },
    { "type": "text", "id": "video_url", "label": "Video URL (desktop)" },
    { "type": "text", "id": "poster_url", "label": "Poster URL (desktop)" },
    { "type": "text", "id": "image_url", "label": "Image URL (desktop)" },
    { "type": "text", "id": "video_url_mobile", "label": "Video URL (mobile)" },
    { "type": "text", "id": "poster_url_mobile", "label": "Poster URL (mobile)" },
    { "type": "text", "id": "image_url_mobile", "label": "Image URL (mobile)" },
    { "type": "text", "id": "alt", "label": "Alt text" }
  ],
  "presets": [{ "name": "SIDIZ WB banner" }]
}
{% endschema %}
