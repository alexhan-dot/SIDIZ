{%- comment -%}
  Faithful rebuild of the kr.sidiz.com `configurator` section.

  The markup below reproduces the Korean DOM exactly — same element names,
  same class names, same nesting — and loads the Korean theme's own compiled
  stylesheets. Layout, spacing and type are therefore identical to kr.sidiz.com
  rather than approximated; only the copy is Australian English and the
  Korean-market modules are dropped.

  Key structure, straight from the KR stylesheet:
    product-page                display:flex; gap:3.75vw
    .product-gallery--wrapper   width:62.5vw, 2-col grid of 3:4 tiles
    .product-text--wrapper      max-width:420px; sticky top:46px; margin:120px 24px 0 0
    .color-chip                 28px ring, with a 20px inner div carrying the colour
{%- endcomment -%}

{%- comment -%}
  Order matters. component-product-variants.css sets
  .product-variant__container--radio{flex-wrap:nowrap}, and
  section-product-configurator.css overrides it back to wrap. Loading the
  configurator sheet last is what lets the chips wrap inside the 420px sidebar.
{%- endcomment -%}
{{ 'theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sidiz-video.js' | asset_url }}" defer="defer"></script>
{{ 'component-product-variants.css' | asset_url | stylesheet_tag }}
{{ 'component-product-item.css' | asset_url | stylesheet_tag }}
{{ 'section-product-configurator.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-au-overrides.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'sidiz-configurator.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'sidiz-360.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign display_title = section.settings.display_title | default: p.title
  assign gallery = section.blocks | where: 'type', 'media'
  assign addons = section.blocks | where: 'type', 'addon'
  assign facts = section.blocks | where: 'type', 'fact'
  assign info = section.blocks | where: 'type', 'info'
-%}

<div class="container" data-sidiz-configurator>
  <product-page>
    <div class="product-gallery--wrapper">
      {%- comment -%}
        The KR grid lives on .product-media--wrapper, not on .product-gallery,
        so every tile has to sit inside that wrapper or the gallery collapses to
        a single column. Below 1023px .web is hidden and .mobile takes over.
      {%- endcomment -%}
      <div class="product-gallery web">
        <div class="product-media--wrapper">
          <div class="product-media--item variant-media">
            {%- for variant in p.variants -%}
              {%- if variant.image != blank -%}
                <img
                  class="variant-image{% unless variant.id == v.id %} hidden{% endunless %}"
                  data-variant-id="{{ variant.id }}"
                  src="{{ variant.image | image_url: width: 1200 }}"
                  srcset="{{ variant.image | image_url: width: 600 }} 600w, {{ variant.image | image_url: width: 1200 }} 1200w, {{ variant.image | image_url: width: 1800 }} 1800w"
                  sizes="(min-width: 1024px) 31vw, 100vw"
                  width="1200"
                  height="1600"
                  alt="{{ variant.image.alt | default: variant.title | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                  decoding="async"
                >
              {%- endif -%}
            {%- endfor -%}

            {%- if section.settings.show_360 -%}
              <div class="btn-img-360" role="button" tabindex="0" data-sidiz-360>
                <div class="btn--icon">
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                    <ellipse cx="8" cy="7" rx="6.4" ry="3" fill="none" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M5.6 12.2 8 14.3l2.4-2.1" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div class="btn--text">360 VIEW</div>
              </div>
            {%- endif -%}
          </div>

        {%- for block in gallery -%}
          <div class="product-media--item" {{ block.shopify_attributes }}>
            {%- if block.settings.video_url != blank -%}
              {% render 'sidiz-video', url: block.settings.video_url, poster: block.settings.poster_url, alt: block.settings.alt, size: '1024' %}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 1024px) 31vw, 100vw',
                  widths: '600,900,1200,1800',
                  alt: block.settings.alt
              }}
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}?width=1200"
                srcset="{{ block.settings.image_url }}?width=600 600w, {{ block.settings.image_url }}?width=1200 1200w, {{ block.settings.image_url }}?width=1800 1800w"
                sizes="(min-width: 1024px) 31vw, 100vw"
                width="1200"
                height="1600"
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
          </div>
        {%- endfor -%}
        </div>
      </div>

      <div class="product-gallery mobile swiper">
        <div class="swiper-wrapper">
          <div class="product-media--item variant-media swiper-slide">
            {%- for variant in p.variants -%}
              {%- if variant.image != blank -%}
                <img
                  class="variant-image{% unless variant.id == v.id %} hidden{% endunless %}"
                  data-variant-id="{{ variant.id }}"
                  src="{{ variant.image | image_url: width: 900 }}"
                  srcset="{{ variant.image | image_url: width: 600 }} 600w, {{ variant.image | image_url: width: 900 }} 900w"
                  sizes="90vw"
                  width="900"
                  height="1200"
                  alt="{{ variant.image.alt | default: variant.title | escape }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- for block in gallery -%}
            <div class="product-media--item swiper-slide">
              {%- if block.settings.video_url != blank -%}
                {% render 'sidiz-video', url: block.settings.video_url, poster: block.settings.poster_url, alt: block.settings.alt, size: '1024' %}
              {%- elsif block.settings.image_url != blank -%}
                <img
                  src="{{ block.settings.image_url }}?width=900"
                  sizes="90vw"
                  width="900"
                  height="1200"
                  alt="{{ block.settings.alt | escape }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="product-text--wrapper">
      <div class="product-title--wrapper web">
        <div class="wrapper--header">
          <h1>{{ display_title }}</h1>
        </div>
        {%- if section.settings.subtitle != blank -%}
          <div class="product-configuration--desc">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>

      {%- if v.sku != blank -%}
        <div class="product--sku" data-sidiz-sku>{{ v.sku }}</div>
      {%- endif -%}

      <div class="product-link--row">
        {%- if section.settings.compare_link != blank -%}
          <div class="button--compare btn-hover--bk">
            <a href="{{ section.settings.compare_link }}">Compare models</a>
          </div>
        {%- endif -%}
        {%- if section.settings.guide_link != blank -%}
          <div class="button--compare btn-hover--bk">
            <a href="{{ section.settings.guide_link }}">Product guide</a>
          </div>
        {%- endif -%}
      </div>

      {%- unless p.has_only_default_variant -%}
        <div class="product-variant--wrapper">
          {%- comment -%}
            KR hides values that cannot be reached rather than striking them
            through — pick a leather and only the leather colours remain. That
            is what product-variants--hide-unavailable does in the KR sheet.
          {%- endcomment -%}
          <product-variants>
            <div class="product-variants product-variants--hide-unavailable">
              {%- for option in p.options_with_values -%}
                {%- liquid
                  assign lower = option.name | downcase
                  assign is_colour = false
                  if lower contains 'colour' or lower contains 'color'
                    assign is_colour = true
                  endif
                -%}
                {%- comment -%}
                  data-option is what gives these chips their look. KR keys the
                  bordered 130x34 pill off [data-option=option|option-2] and the
                  round swatch off [data-option=color]. I removed the attribute
                  earlier after misreading an unrelated grid rule, which is why
                  the chips lost their borders and the colour swatches came out
                  empty.
                {%- endcomment -%}
                {%- liquid
                  assign data_option = 'option'
                  if is_colour
                    assign data_option = 'color'
                  elsif option.position > 1
                    assign data_option = 'option-' | append: option.position
                  endif
                -%}
                <div class="product-variant depth-{{ forloop.index }}" data-option="{{ data_option }}">
                  {%- if is_colour -%}
                    <span class="product-variant__name">{{ option.name }}</span>
                  {%- endif -%}
                  <div class="product-variant__container product-variant__container--radio product-variant__container--radio--wrap">
                    {%- for value in option.values -%}
                      <div class="product-variant__item product-variant__item--radio">
                        <input
                          class="product-variant__input product-variant-value"
                          type="radio"
                          id="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          name="opt-{{ section.id }}-{{ option.position }}"
                          value="{{ value | escape }}"
                          data-option-position="{{ option.position }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label class="product-variant__label" for="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                          {%- if is_colour -%}
                            {% render 'sidiz-swatch', value: value %}
                          {%- endif -%}
                          <div class="option-name">{{ value }}</div>
                        </label>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </product-variants>
        </div>
      {%- endunless -%}

      <div class="product-price--wrapper">
        <div class="product-price">
          <div class="product-discount--wrapper">
            <div class="member--discount">
              <div class="discount--details" data-sidiz-price>
                <div class="discount--details-top">
                  {%- if v.compare_at_price > v.price -%}
                    <div class="product-discount--percent">
                      {{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}%
                    </div>
                  {%- endif -%}
                  <div class="product-price--best">{{ v.price | money }}</div>
                </div>
                {%- if v.compare_at_price > v.price -%}
                  <div class="product-price--original">{{ v.compare_at_price | money }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
        {%- if section.settings.tax_note != blank -%}
          <div class="product-price--tax">{{ section.settings.tax_note }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.payment_note != blank -%}
        <div class="product-payment--note">{{ section.settings.payment_note }}</div>
      {%- endif -%}

      {%- if addons.size > 0 -%}
        <div class="product-complementary--wrapper">
          <div class="wrapper--header">
            <div class="title">{{ section.settings.addons_title }}</div>
          </div>
          <div class="wrapper--body">
            <div class="complementary--content">
              {%- for block in addons -%}
                {%- assign item = block.settings.product -%}
                {%- if item != blank -%}
                  <div class="product-item-compact" {{ block.shopify_attributes }}>
                    <div class="product-item--image">
                      <a href="{{ item.url }}">
                        {%- if item.featured_media != blank -%}
                          {{
                            item.featured_media.preview_image
                            | image_url: width: 300
                            | image_tag: loading: 'lazy', widths: '150,300', alt: item.title
                          }}
                        {%- endif -%}
                      </a>
                    </div>
                    <div class="product-item-details">
                      <div class="title">{{ item.title }}</div>
                      <div class="product-item-price">
                        <div class="discount-price">{{ item.price | money }}</div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="product-actions">
        {%- form 'product', p, id: 'sidiz-product-form', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-sidiz-variant-id>
          <div class="product__cart-functions">
            <div class="button__cart-div">
              <button
                class="add-to-cart button button--solid button--product"
                type="submit"
                name="add"
                {% if v.available == false %}disabled{% endif %}
              >
                <span class="button__text" data-sidiz-atc-label>
                  {%- if v.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>
            </div>
          </div>
        {%- endform -%}
      </div>

      {%- if facts.size > 0 -%}
        <div class="product-delivery-and-warranty--wrapper">
          <div class="product-delivery--wrapper">
            <div class="delivery--header">
              <div class="delivery--title">{{ section.settings.delivery_title }}</div>
            </div>
            <div class="delivery--body">
              {%- for block in facts -%}
                <div class="product--data" {{ block.shopify_attributes }}>
                  <div class="data--title"><span>{{ block.settings.label }}</span></div>
                  <div class="data--text">{{ block.settings.value }}</div>
                </div>
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.warranty_value != blank -%}
            <div class="product-warranty--wrapper">
              <div class="product--data warranty--period">
                <div class="data--title">{{ section.settings.warranty_label }}</div>
                <div class="data--text">{{ section.settings.warranty_value }}</div>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.notice != blank -%}
        <div class="notice--title product-notice--title">{{ section.settings.notice_title }}</div>
        <div class="product-notice--wrapper">
          <div class="notice--content rich-text-area">{{ section.settings.notice }}</div>
        </div>
      {%- endif -%}

      {%- if info.size > 0 -%}
        <div class="product-basic-info--wrapper">
          <details {% if section.settings.basic_info_open %}open{% endif %}>
            <summary class="basic-info--header">
              <div class="basic-info--title">{{ section.settings.basic_info_title }}</div>
              <div class="arrow">
                <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
                  <path d="M2 5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </summary>

            <div class="basic-info--body">
              {%- for block in info -%}
                {%- comment -%}
                  A value holding several entries is set one per line. KR lists
                  them stacked and top-aligns the label against them, which is
                  what .color--data does.
                {%- endcomment -%}
                {%- assign lines = block.settings.value | strip | newline_to_br | split: '<br />' -%}
                <div
                  class="product--data{% if lines.size > 1 %} color--data{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="data--title">{{ block.settings.label }}</div>
                  <div class="data--text">
                    {%- if lines.size > 1 -%}
                      {%- for line in lines -%}
                        {%- assign entry = line | strip -%}
                        {%- if entry != blank -%}<p>{{ entry }}</p>{%- endif -%}
                      {%- endfor -%}
                    {%- else -%}
                      {{ block.settings.value }}
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </details>
        </div>
      {%- endif -%}
    </div>
  </product-page>

  {%- comment -%}
    360 viewer. KR ships one .modal-360 per colour; the same is done here, keyed
    by the handleized colour so the viewer opens on whatever the shopper has
    selected. Frames stay hidden until opened so none of them are fetched on
    first paint.
  {%- endcomment -%}
  {%- assign spins = section.blocks | where: 'type', 'spin' -%}
  {%- for block in spins -%}
    <div
      class="modal-360 hidden"
      data-sidiz-360-modal
      data-colour="{{ block.settings.colour | handleize }}"
      role="dialog"
      aria-modal="true"
      aria-label="360 degree view"
      {{ block.shopify_attributes }}
    >
      <div class="close--button btn-hover--bk" role="button" tabindex="0" data-sidiz-360-close aria-label="Close">
        <img src="{{ 'icon-close-line-bk.svg' | asset_url }}" width="28" height="28" alt="" loading="lazy">
      </div>

      <div class="swiper modal-360--swiper">
        <div class="swiper-wrapper">
          {%- assign frames = block.settings.frames | split: ',' -%}
          {%- for frame in frames -%}
            {%- assign src = frame | strip -%}
            {%- if src != blank -%}
              <div class="swiper-slide image-360">
                <img
                  data-src="{{ src }}?width=1400"
                  alt="{{ block.settings.alt | default: 'SIDIZ T90, rotated view' | escape }}"
                  width="1400"
                  height="1400"
                  loading="lazy"
                  decoding="async"
                >
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="navigation-360">
        <div class="navigation-prev btn-hover--bk" role="button" tabindex="0" aria-label="Previous">
          <img src="{{ 'icon-arrow-left-line-bk-28.svg' | asset_url }}" width="28" height="28" alt="" loading="lazy">
        </div>
        <div class="navigation-next btn-hover--bk" role="button" tabindex="0" aria-label="Next">
          <img src="{{ 'icon-arrow-right-line-bk-28.svg' | asset_url }}" width="28" height="28" alt="" loading="lazy">
        </div>
      </div>
    </div>
  {%- endfor -%}

  <script type="application/json" data-sidiz-variants>
    {{ p.variants | json }}
  </script>
</div>

{% render 'sidiz-product-schema', product: p %}

{% schema %}
{
  "name": "SIDIZ PDP head",
  "tag": "div",
  "class": "mount-product-page mount-show-more section-product-configurator",
  "settings": [
    {
      "type": "text",
      "id": "display_title",
      "label": "Display title",
      "info": "Shown as the H1. Leave blank to use the full product title."
    },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "checkbox", "id": "show_360", "label": "Show the 360 VIEW control", "default": true },
    { "type": "url", "id": "compare_link", "label": "Compare models link" },
    { "type": "url", "id": "guide_link", "label": "Product guide link" },
    { "type": "header", "content": "Price" },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "Price includes GST. Shipping calculated at checkout."
    },
    { "type": "richtext", "id": "payment_note", "label": "Payment note" },
    { "type": "header", "content": "Add-ons" },
    { "type": "text", "id": "addons_title", "label": "Add-ons heading", "default": "Add to your setup" },
    { "type": "header", "content": "Delivery and warranty" },
    { "type": "text", "id": "delivery_title", "label": "Delivery heading", "default": "Delivery" },
    { "type": "text", "id": "warranty_label", "label": "Warranty label", "default": "Warranty" },
    { "type": "text", "id": "warranty_value", "label": "Warranty value", "default": "15 years" },
    { "type": "header", "content": "Basic info" },
    { "type": "text", "id": "basic_info_title", "label": "Basic info heading", "default": "BASIC INFO" },
    { "type": "checkbox", "id": "basic_info_open", "label": "Open by default", "default": false },
    { "type": "header", "content": "Before you buy" },
    { "type": "text", "id": "notice_title", "label": "Notice heading", "default": "Before you buy" },
    { "type": "richtext", "id": "notice", "label": "Notice" }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Gallery media",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "video_url", "label": "Video URL" },
        { "type": "text", "id": "poster_url", "label": "Video poster URL" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    },
    {
      "type": "addon",
      "name": "Add-on product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    },
    {
      "type": "fact",
      "name": "Delivery fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    },
    {
      "type": "info",
      "name": "Basic info row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "textarea", "id": "value", "label": "Value", "info": "One entry per line to render a list, as KR does for colours." }
      ]
    },
    {
      "type": "spin",
      "name": "360 view set",
      "settings": [
        {
          "type": "text",
          "id": "colour",
          "label": "Colour",
          "info": "Must match the Colour option value exactly, e.g. Shadow Grey."
        },
        {
          "type": "textarea",
          "id": "frames",
          "label": "Frame URLs",
          "info": "Comma-separated, in rotation order."
        },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ]
}
{% endschema %}
