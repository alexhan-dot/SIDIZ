{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sidiz-configurator.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Rebuild of the kr.sidiz.com `configurator` section.

  Layout matches the Korean page exactly:
    .product-gallery--wrapper  62.5vw, a two-column grid of 3:4 media tiles
    .product-text--wrapper     420px, sticky at top:46px, margin-top 120px

  The first gallery tile is the variant image with the 360 VIEW control over it;
  every other tile is a looping product video.

  Korean-market pieces are dropped rather than translated: KakaoTalk sharing,
  card interest-free instalment info, Jeju Island surcharge, KC certification.
{%- endcomment -%}

{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
  endif
-%}

<section class="sidiz-configurator" id="sidiz-pdp-head" data-sidiz-configurator>
  <div class="product-gallery--wrapper">
    {%- comment -%} Mobile: one swiper-style scroller. Desktop: the 2-col grid. {%- endcomment -%}
    <div class="product-gallery product-gallery--web">
      <div class="product-media--item variant-media">
        {%- for variant in p.variants -%}
          {%- if variant.image != blank -%}
            <img
              class="variant-image{% unless variant.id == v.id %} is-hidden{% endunless %}"
              data-variant-id="{{ variant.id }}"
              src="{{ variant.image | image_url: width: 1200 }}"
              srcset="{{ variant.image | image_url: width: 600 }} 600w, {{ variant.image | image_url: width: 1200 }} 1200w, {{ variant.image | image_url: width: 1800 }} 1800w"
              sizes="(min-width: 1024px) 31vw, 100vw"
              width="1200"
              height="1600"
              alt="{{ variant.image.alt | default: variant.title | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {% if forloop.first %}fetchpriority="high"{% endif %}
              decoding="async"
            >
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.show_360 -%}
          <button class="btn-img-360" type="button" data-sidiz-360>
            <span class="btn--icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14">
                <path d="M8 3.5c3.6 0 6.5 1.3 6.5 3s-2.9 3-6.5 3-6.5-1.3-6.5-3 2.9-3 6.5-3Z" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <path d="M5.5 12.5 8 14.5l2.5-2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="btn--text">360 VIEW</span>
          </button>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'media' -%}
          <div class="product-media--item" {{ block.shopify_attributes }}>
            {%- if block.settings.video_url != blank -%}
              <video
                src="{{ block.settings.video_url }}"
                {% if block.settings.poster_url != blank %}poster="{{ block.settings.poster_url }}"{% endif %}
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                {% if block.settings.alt != blank %}aria-label="{{ block.settings.alt | escape }}"{% endif %}
              ></video>
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 1024px) 31vw, 100vw',
                  widths: '600,900,1200,1800',
                  alt: block.settings.alt
              }}
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}?width=1200"
                srcset="{{ block.settings.image_url }}?width=600 600w, {{ block.settings.image_url }}?width=1200 1200w, {{ block.settings.image_url }}?width=1800 1800w"
                sizes="(min-width: 1024px) 31vw, 100vw"
                width="1200"
                height="1600"
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="product-text--wrapper">
    <div class="product-title--wrapper">
      <div class="wrapper--header">
        <h1>{{ p.title | remove: 'SIDIZ ' | remove: ' Ergonomic Office Chair' }}</h1>
        <button class="button--share" type="button" data-sidiz-share aria-label="Share this product">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M13.5 6.5a2 2 0 1 0-1.9-2.6L7.9 5.8a2 2 0 1 0 0 2.9l3.7 1.9a2 2 0 1 0 .6-1.1L8.5 7.6a2 2 0 0 0 0-.9l3.7-1.9c.36.44.9.7 1.3.7Z" fill="currentColor"/>
          </svg>
        </button>
      </div>
    </div>

    {%- if v.sku != blank -%}
      <p class="product--sku" data-sidiz-sku>{{ v.sku }}</p>
    {%- endif -%}

    <div class="product-link--row">
      {%- if section.settings.compare_link != blank -%}
        <a class="button--compare" href="{{ section.settings.compare_link }}">Compare models</a>
      {%- endif -%}
      {%- if section.settings.guide_link != blank -%}
        <a class="button--compare" href="{{ section.settings.guide_link }}">Product guide</a>
      {%- endif -%}
      <a class="button--compare" href="#reviews">Reviews</a>
    </div>

    {%- unless p.has_only_default_variant -%}
      <div class="product-variant--wrapper">
        {%- for option in p.options_with_values -%}
          {%- liquid
            assign is_colour = false
            assign lower = option.name | downcase
            if lower contains 'colour' or lower contains 'color'
              assign is_colour = true
            endif
          -%}
          <div class="product-variant depth-{{ forloop.index }}{% if is_colour %} product-variant--colour{% endif %}">
            <span class="product-variant__name">
              {{ option.name }}
              <em data-sidiz-option-value="{{ option.position }}">{{ option.selected_value }}</em>
            </span>
            <div class="product-variant__container">
              {%- for value in option.values -%}
                <div class="product-variant__item">
                  <input
                    class="product-variant__input"
                    type="radio"
                    id="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                    name="opt-{{ section.id }}-{{ option.position }}"
                    value="{{ value | escape }}"
                    data-option-position="{{ option.position }}"
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <label class="product-variant__label" for="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                    {%- if is_colour -%}
                      {%- comment -%}
                        Colour comes from the swatch when the merchant has set
                        one, otherwise from the theme's colour map in
                        sidiz-configurator.css keyed by the handleized name.
                      {%- endcomment -%}
                      <span
                        class="color-chip"
                        data-colour="{{ value | handleize }}"
                        {% if value.swatch.color %}style="--chip: {{ value.swatch.color }};"
                        {% elsif value.swatch.image %}style="background-image: url({{ value.swatch.image | image_url: width: 56 }});"
                        {% endif %}
                      ></span>
                    {%- endif -%}
                    <span class="option-name">{{ value }}</span>
                  </label>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <div class="product-price--wrapper">
      <div class="product-price" data-sidiz-price>
        {%- if on_sale -%}
          <div class="discount--details-top">
            <span class="product-discount--percent">
              {{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}%
            </span>
            <span class="product-price--best">{{ v.price | money }}</span>
          </div>
          <s class="product-price--original">{{ v.compare_at_price | money }}</s>
        {%- else -%}
          <div class="discount--details-top">
            <span class="product-price--best">{{ v.price | money }}</span>
          </div>
        {%- endif -%}
      </div>
      <p class="product-price--tax">{{ section.settings.tax_note }}</p>
    </div>

    {%- if section.settings.payment_note != blank -%}
      <div class="product-payment--note">{{ section.settings.payment_note }}</div>
    {%- endif -%}

    {%- assign addons = section.blocks | where: 'type', 'addon' -%}
    {%- if addons.size > 0 -%}
      <div class="product-complementary--wrapper">
        <div class="wrapper--header">
          <span class="title">{{ section.settings.addons_title }}</span>
        </div>
        <div class="complementary--content">
          {%- for block in addons -%}
            {%- assign item = block.settings.product -%}
            {%- if item != blank -%}
              <div class="product-item-compact" {{ block.shopify_attributes }}>
                <a class="product-item--image" href="{{ item.url }}">
                  {%- if item.featured_media != blank -%}
                    {{
                      item.featured_media.preview_image
                      | image_url: width: 300
                      | image_tag: loading: 'lazy', widths: '150,300', alt: item.title
                    }}
                  {%- endif -%}
                </a>
                <div class="product-item-details">
                  <span class="title">{{ item.title }}</span>
                  <span class="discount-price">{{ item.price | money }}</span>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="product-actions">
      {%- form 'product', p, id: 'sidiz-product-form', class: 'product-form' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-sidiz-variant-id>
        <div class="product__cart-functions">
          <button class="add-to-cart" type="submit" name="add" {% if v.available == false %}disabled{% endif %}>
            <span class="button__text" data-sidiz-atc-label>
              {%- if v.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        </div>
      {%- endform -%}
    </div>

    {%- assign facts = section.blocks | where: 'type', 'fact' -%}
    {%- if facts.size > 0 -%}
      <div class="product-delivery-and-warranty--wrapper">
        <div class="product-delivery--wrapper">
          <div class="delivery--header">
            <span class="delivery--title">{{ section.settings.delivery_title }}</span>
          </div>
          <div class="delivery--body">
            {%- for block in facts -%}
              <div class="product--data" {{ block.shopify_attributes }}>
                <div class="data--title">{{ block.settings.label }}</div>
                <div class="data--text">{{ block.settings.value }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.warranty_value != blank -%}
          <div class="product-warranty--wrapper">
            <div class="product--data warranty--period">
              <div class="data--title">{{ section.settings.warranty_label }}</div>
              <div class="data--text">{{ section.settings.warranty_value }}</div>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.notice != blank -%}
      <div class="notice--title">{{ section.settings.notice_title }}</div>
      <div class="product-notice--wrapper">
        <div class="notice--content rte">{{ section.settings.notice }}</div>
      </div>
    {%- endif -%}

    {%- assign info = section.blocks | where: 'type', 'info' -%}
    {%- if info.size > 0 -%}
      <details class="product-basic-info--wrapper">
        <summary class="basic-info--header">
          <span class="basic-info--title">BASIC INFO</span>
          <span class="arrow" aria-hidden="true"></span>
        </summary>
        <div class="basic-info--body">
          {%- for block in info -%}
            <div class="product--data" {{ block.shopify_attributes }}>
              <div class="data--title">{{ block.settings.label }}</div>
              <div class="data--text">{{ block.settings.value }}</div>
            </div>
          {%- endfor -%}
        </div>
      </details>
    {%- endif -%}
  </div>

  <script type="application/json" data-sidiz-variants>
    {{ p.variants | json }}
  </script>
</section>

{% render 'sidiz-product-schema', product: p %}

{% schema %}
{
  "name": "SIDIZ PDP head",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_360", "label": "Show the 360 VIEW control", "default": true },
    { "type": "url", "id": "compare_link", "label": "Compare models link" },
    { "type": "url", "id": "guide_link", "label": "Product guide link" },
    { "type": "header", "content": "Price" },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "Price includes GST. Shipping calculated at checkout.",
      "info": "Australian retail prices must be shown GST-inclusive."
    },
    {
      "type": "richtext",
      "id": "payment_note",
      "label": "Payment note",
      "info": "e.g. Afterpay or Zip availability. Replaces the Korean card instalment panel."
    },
    { "type": "header", "content": "Add-ons" },
    { "type": "text", "id": "addons_title", "label": "Add-ons heading", "default": "Add to your setup" },
    { "type": "header", "content": "Delivery and warranty" },
    { "type": "text", "id": "delivery_title", "label": "Delivery heading", "default": "Delivery" },
    { "type": "text", "id": "warranty_label", "label": "Warranty label", "default": "Warranty" },
    { "type": "text", "id": "warranty_value", "label": "Warranty value", "default": "15 years" },
    { "type": "header", "content": "Before you buy" },
    { "type": "text", "id": "notice_title", "label": "Notice heading", "default": "Before you buy" },
    { "type": "richtext", "id": "notice", "label": "Notice" }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Gallery media",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "video_url", "label": "Video URL" },
        { "type": "text", "id": "poster_url", "label": "Video poster URL" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    },
    {
      "type": "addon",
      "name": "Add-on product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    },
    {
      "type": "fact",
      "name": "Delivery fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    },
    {
      "type": "info",
      "name": "Basic info row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    }
  ]
}
{% endschema %}
