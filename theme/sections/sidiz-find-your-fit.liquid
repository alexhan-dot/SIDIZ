{%- comment -%}
  Port of the KR `product_find_your_fit` section — a grid of adjustment tiles
  with a USER GUIDE button in the header. My earlier version was a tabbed
  left-hand nav, which is a different component entirely.

  KR structure:
    section.section-product-find-your-fit
      > .container
          > .container--header > h2.title + .subtitle + .btn.find-your-fit-btn > a
          > .container--body > .wrapper--card-list
              > .card--item > .card--media > img|video
                            > .card--text > .title + .description.rich-text-area > .size-15
{%- endcomment -%}

{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'section-product-find-your-fit.css' | asset_url | stylesheet_tag }}

<div class="container">
  <div class="container--header">
    {%- if section.settings.heading != blank -%}
      <h2 class="title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <div class="subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    {%- if section.settings.guide_link != blank -%}
      <div class="btn find-your-fit-btn btn-hover--bk">
        <a href="{{ section.settings.guide_link }}" title="">
          {{ section.settings.guide_label | default: 'USER GUIDE' }}
        </a>
      </div>
    {%- endif -%}
  </div>

  <div class="container--body">
    <div class="wrapper--card-list">
      {%- for block in section.blocks -%}
        <div class="card--item" {{ block.shopify_attributes }}>
          <div class="card--media">
            {%- if block.settings.video_url != blank -%}
              <video
                playsinline="playsinline"
                autoplay="autoplay"
                loop="loop"
                muted="muted"
                preload="metadata"
                loading="lazy"
                {% if block.settings.alt != blank %}aria-label="{{ block.settings.alt | escape }}"{% endif %}
                {% if block.settings.poster_url != blank %}poster="{{ block.settings.poster_url }}"{% endif %}
              >
                <source src="{{ block.settings.video_url }}" type="video/mp4">
                {%- if block.settings.poster_url != blank -%}
                  <img alt="{{ block.settings.alt | escape }}" src="{{ block.settings.poster_url }}">
                {%- endif -%}
              </video>
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}?width=900"
                srcset="{{ block.settings.image_url }}?width=450 450w, {{ block.settings.image_url }}?width=900 900w"
                sizes="(min-width: 1024px) 30vw, 90vw"
                width="900"
                height="675"
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
                decoding="async"
              >
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '450,900', alt: block.settings.alt
              }}
            {%- endif -%}
          </div>

          <div class="card--text">
            {%- if block.settings.title != blank -%}
              <div class="title">{{ block.settings.title }}</div>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="description rich-text-area">
                <div class="size-15">{{ block.settings.description }}</div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SIDIZ find your fit",
  "tag": "section",
  "class": "section-product-find-your-fit",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "T90 adjustment guide" },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sub-title",
      "default": "FIND YOUR FIT. Set it up for your body"
    },
    { "type": "text", "id": "guide_label", "label": "Button label", "default": "USER GUIDE" },
    { "type": "url", "id": "guide_link", "label": "User guide page" }
  ],
  "blocks": [
    {
      "type": "adjustment",
      "name": "Adjustment",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "info": "The purpose, e.g. \"To suit your body\"." },
        { "type": "richtext", "id": "description", "label": "Description", "info": "The controls, e.g. \"Seat height / seat depth\"." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "video_url", "label": "Video URL" },
        { "type": "text", "id": "poster_url", "label": "Video poster URL" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIDIZ find your fit",
      "blocks": [{ "type": "adjustment" }, { "type": "adjustment" }, { "type": "adjustment" }]
    }
  ]
}
{% endschema %}
