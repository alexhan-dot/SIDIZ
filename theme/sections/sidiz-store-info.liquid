{%- comment -%}
  Port of the KR `product_store_info` section — an invitation to sit in the
  chair, with a wide showroom photograph beneath.

  KR structure:
    section.section-product-store-info
      > .container > .wrapper
          > .wrapper--header > h2.title + .description + .btn.btn-hover--bk > a
          > .wrapper--body > .shop--image > img.web + img.mobile

  Australia has no SIDIZ showroom network, so the copy points at stockists or
  the returns policy rather than translating "visit a SIDIZ store".
{%- endcomment -%}

{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'section-product-store-info.css' | asset_url | stylesheet_tag }}

<div class="container">
  <div class="wrapper">
    <div class="wrapper--header">
      {%- if section.settings.heading != blank -%}
        <h2 class="title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="description">{{ section.settings.description }}</div>
      {%- endif -%}
      {%- if section.settings.link != blank -%}
        <div class="btn btn-hover--bk">
          <a href="{{ section.settings.link }}">{{ section.settings.link_label | default: 'Find a stockist' }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.image_url != blank or section.settings.image_url_mobile != blank -%}
      <div class="wrapper--body">
        <div class="shop--image">
          {%- if section.settings.image_url != blank -%}
            <img
              class="web"
              src="{{ section.settings.image_url }}?width=2000"
              srcset="{{ section.settings.image_url }}?width=1000 1000w, {{ section.settings.image_url }}?width=2000 2000w"
              sizes="100vw"
              width="2000"
              height="800"
              alt="{{ section.settings.alt | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
          {%- if section.settings.image_url_mobile != blank -%}
            <img
              class="mobile"
              src="{{ section.settings.image_url_mobile }}?width=1200"
              sizes="100vw"
              width="1200"
              height="1200"
              alt="{{ section.settings.alt | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SIDIZ store info",
  "tag": "section",
  "class": "section-product-store-info",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sit in one before you decide" },
    { "type": "html", "id": "description", "label": "Description", "info": "Use <br> for line breaks." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Find a stockist" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "image_url", "label": "Image URL (desktop)" },
    { "type": "text", "id": "image_url_mobile", "label": "Image URL (mobile)" },
    { "type": "text", "id": "alt", "label": "Alt text" }
  ],
  "presets": [{ "name": "SIDIZ store info" }]
}
{% endschema %}
