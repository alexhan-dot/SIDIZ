{%- comment -%}
  Port of the KR `product_wb_scroll_banner` section.

  Built from the section's actual rendered HTML (data/products/t90/sections/),
  not from reading its stylesheet. That matters: the KR theme scopes a
  per-section <style data-shopify> block to a unique `section-<id>` class on
  .container, and the text colours live there rather than in any of the shared
  stylesheets. Reproducing only the external CSS gives the right layout with the
  wrong colours.

  KR structure:
    section.section-product-wb-scroll-banner
      > .container.section-<id>
          > .container--header > h2.title
          > .container--body
              > .wrapper--background > video.web + video.mobile
              > .wrapper--sticky > .content--text
                  > .tag + h3.title + .description.rich-text-area > .size-18
{%- endcomment -%}

{{ 'theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sidiz-video.js' | asset_url }}" defer="defer"></script>
{{ 'section-product-wb-scroll.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-product-wb-scroll.js' | asset_url }}" defer="defer"></script>

{%- assign scope = 'section-' | append: section.id -%}

<div class="container {{ scope }}" data-header-scheme="{{ section.settings.header_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="container--header">
      <h2 class="title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <style data-shopify>
    .{{ scope }} .title { margin: 0; padding: 0; }
    .{{ scope }} .container--header .title { color: {{ section.settings.heading_colour }}; }
  </style>

  <div class="container--body">
    <div class="wrapper--background">
      {%- if section.settings.video_url != blank -%}
        {% render 'sidiz-video', url: section.settings.video_url, poster: section.settings.poster_url, alt: section.settings.alt, classes: 'web', eager: true, size: 'full' %}
      {%- endif -%}

      {%- if section.settings.video_url_mobile != blank -%}
        {% render 'sidiz-video', url: section.settings.video_url_mobile, poster: section.settings.poster_url_mobile, alt: section.settings.alt, classes: 'mobile', size: 'full' %}
      {%- endif -%}

      {%- comment -%}
        Still-image background. The GX page pins a photograph here where the
        T-series pages pin footage.
      {%- endcomment -%}
      {%- if section.settings.video_url == blank and section.settings.image_url != blank -%}
        <img
          class="web"
          src="{{ section.settings.image_url }}?width=2400"
          sizes="100vw"
          width="2400"
          height="1350"
          alt="{{ section.settings.alt | escape }}"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
      {%- if section.settings.video_url_mobile == blank and section.settings.image_url_mobile != blank -%}
        <img
          class="mobile"
          src="{{ section.settings.image_url_mobile }}?width=1200"
          sizes="100vw"
          width="1200"
          height="1800"
          alt="{{ section.settings.alt | escape }}"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
    </div>

    <div class="wrapper--sticky">
      <div class="content--text">
        {%- if section.settings.tag != blank -%}
          <div class="tag">{{ section.settings.tag }}</div>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <h3 class="title">{{ section.settings.subheading }}</h3>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="description rich-text-area">
            <div class="size-18">{{ section.settings.description }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <style data-shopify>
    .{{ scope }} .container--body .content--text .tag {
      color: {{ section.settings.tag_colour }};
      background-color: {{ section.settings.tag_background }};
    }
    .{{ scope }} .container--body .content--text .title { color: {{ section.settings.text_colour }}; }
    .{{ scope }} .container--body .content--text .description { color: {{ section.settings.text_colour }}; }
    @media screen and (max-width: 1023px) {
      .{{ scope }} .container--body .content--text .tag {
        color: {{ section.settings.tag_colour }};
        background-color: {{ section.settings.tag_background }};
      }
      .{{ scope }} .container--body .content--text .title { color: {{ section.settings.text_colour }}; }
      .{{ scope }} .container--body .content--text .description { color: {{ section.settings.text_colour }}; }
    }
  </style>
</div>

{% schema %}
{
  "name": "SIDIZ WB scroll banner",
  "tag": "section",
  "class": "section-product-wb-scroll-banner",
  "settings": [
    {
      "type": "select",
      "id": "header_scheme",
      "label": "Header text over this section",
      "options": [
        { "value": "light", "label": "Black (light background)" },
        { "value": "dark", "label": "White (dark background)" }
      ],
      "default": "dark",
      "info": "Sets which colour the floating header switches to while this section is under it."
    },
    { "type": "html", "id": "heading", "label": "Heading", "info": "Use <br> for the line break." },
    { "type": "color", "id": "heading_colour", "label": "Heading colour", "default": "#000000" },
    { "type": "text", "id": "tag", "label": "Tag" },
    { "type": "color", "id": "tag_colour", "label": "Tag text colour", "default": "#000000" },
    { "type": "color", "id": "tag_background", "label": "Tag background", "default": "#eaedf0" },
    { "type": "html", "id": "subheading", "label": "Sub-heading" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "color",
      "id": "text_colour",
      "label": "Sub-heading and description colour",
      "default": "#ffffff"
    },
    { "type": "header", "content": "Media" },
    { "type": "text", "id": "video_url", "label": "Video URL (desktop)" },
    { "type": "text", "id": "poster_url", "label": "Poster URL (desktop)" },
    { "type": "text", "id": "video_url_mobile", "label": "Video URL (mobile)" },
    { "type": "text", "id": "poster_url_mobile", "label": "Poster URL (mobile)" },
    { "type": "text", "id": "image_url", "label": "Image URL (desktop)", "info": "Used when no video is set." },
    { "type": "text", "id": "image_url_mobile", "label": "Image URL (mobile)" },
    { "type": "text", "id": "alt", "label": "Alt text" }
  ],
  "presets": [{ "name": "SIDIZ WB scroll banner" }]
}
{% endschema %}
