{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KR product-notice — 주의사항. Purchase notes, safety warnings and delivery
  terms. Warning blocks render with role="note" so screen readers announce them
  rather than treating them as decoration.
{%- endcomment -%}

<section
  class="sidiz-notice sidiz-section"
  style="--notice-bg: {{ section.settings.background }};"
  id="{{ section.settings.anchor_id | default: 'before-you-buy' | handleize }}"
>
  <div class="sidiz-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="sidiz-notice__heading sidiz-display">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="sidiz-notice__list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'note' -%}
            <div class="sidiz-notice__item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="sidiz-notice__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              <div class="sidiz-notice__text rte">{{ block.settings.text }}</div>
            </div>

          {%- when 'warning' -%}
            <div class="sidiz-notice__item sidiz-notice__item--warning" role="note" {{ block.shopify_attributes }}>
              <span class="sidiz-notice__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="20" height="20">
                  <path d="M10 2 1 18h18L10 2Zm0 6v5m0 2.5v.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="sidiz-notice__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                <div class="sidiz-notice__text rte">{{ block.settings.text }}</div>
              </div>
            </div>

          {%- when 'table' -%}
            <div class="sidiz-notice__item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="sidiz-notice__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {% render 'sidiz-media',
                image: block.settings.image,
                url: block.settings.media_url,
                alt: block.settings.alt,
                sizes: '(min-width: 834px) 60vw, 100vw'
              %}
              {%- if block.settings.text != blank -%}
                <div class="sidiz-notice__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SIDIZ notices",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you buy" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "before-you-buy" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f5f6f7" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "warning",
      "name": "Safety warning",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "table",
      "name": "Table or chart image",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "media_url", "label": "Media URL" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    { "name": "SIDIZ notices", "blocks": [{ "type": "note" }, { "type": "warning" }] }
  ]
}
{% endschema %}
