{{ 'sidiz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sidiz-sections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  KR product_wb_scroll_banner: a pinned full-viewport panel whose caption fades
  in as the visitor scrolls through it. Built on position:sticky and a scroll
  driven opacity, so it degrades to a plain stacked banner where sticky or
  scroll-timeline is unsupported, and stays still entirely under
  prefers-reduced-motion.
{%- endcomment -%}

<section
  class="sidiz-scrollban"
  style="--sb-fg: {{ section.settings.text_colour }}; --sb-scrim: {{ section.settings.scrim }}; --sb-len: {{ section.settings.scroll_length }}vh;"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
>
  <div class="sidiz-scrollban__rail">
    <div class="sidiz-scrollban__pin">
      {% render 'sidiz-media',
        image: section.settings.image,
        video: section.settings.video,
        url: section.settings.media_url,
        poster: section.settings.poster_url,
        alt: section.settings.alt,
        loading: 'lazy',
        sizes: '100vw',
        class: 'sidiz-scrollban__media'
      %}

      <div class="sidiz-scrollban__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sidiz-scrollban__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sidiz-scrollban__heading sidiz-display">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="sidiz-scrollban__text rte">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="sidiz-scrollban__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SIDIZ scroll banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video" },
    {
      "type": "text",
      "id": "media_url",
      "label": "Media URL",
      "info": "Draft-build fallback for media not yet uploaded to Files."
    },
    { "type": "text", "id": "poster_url", "label": "Video poster URL" },
    { "type": "text", "id": "alt", "label": "Alt text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "note", "label": "Footnote", "info": "Patent numbers, disclaimers." },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Scroll length",
      "min": 100,
      "max": 300,
      "step": 20,
      "unit": "vh",
      "default": 200,
      "info": "How far the panel stays pinned."
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "color", "id": "text_colour", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "scrim", "label": "Scrim", "default": "rgba(0,0,0,0.3)" }
  ],
  "presets": [{ "name": "SIDIZ scroll banner" }]
}
{% endschema %}
