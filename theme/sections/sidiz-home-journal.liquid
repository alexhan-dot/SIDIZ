{%- assign selected_blog = section.settings.blog -%}
<section class="sidiz-journal">
  <header class="sidiz-journal__head">
    <div>
      <p class="sidiz-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if selected_blog != blank -%}<a href="{{ selected_blog.url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </header>

  <div class="sidiz-journal__grid">
    {%- if selected_blog != blank -%}
      {%- for article in selected_blog.articles limit: 3 -%}
        <article class="sidiz-journal-card">
          <a href="{{ article.url }}">
            <div class="sidiz-journal-card__image">
              {%- if article.image != blank -%}
                {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 801px) 33vw, 100vw', widths: '480,720,960,1200', alt: article.image.alt | default: article.title }}
              {%- endif -%}
            </div>
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %B %Y' }}</time>
            <h3>{{ article.title | escape }}</h3>
          </a>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% render 'sidiz-section-editor-controls' %}

{% schema %}
{
  "name": "SIDIZ journal",
  "settings": [
    {
      "type": "header",
