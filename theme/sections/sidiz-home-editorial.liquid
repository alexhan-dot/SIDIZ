        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "regular",
          "label": "Regular"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "editor_text_alignment",
      "label": "Text alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Section default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "editor_apply_color_scheme",
      "label": "Use selected colour scheme",
      "default": false
