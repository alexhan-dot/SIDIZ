        "title_colour": "#ffffff",
        "description_colour": "#ffffff",
        "image_url": "https://kr.sidiz.com/cdn/shop/files/article_1_eb918cb9-cf3a-4745-9e18-b9c3137b1369.jpg",
        "image_url_mobile": "https://kr.sidiz.com/cdn/shop/files/pillo_Type_B-2_M.jpg",
        "alt": "The PILLO folded away neatly"
