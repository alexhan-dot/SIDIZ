{%- comment -%}
  One product tile in a SIDIZ related-products rail.
  Accepts: item (product), attrs (optional shopify_attributes string)
{%- endcomment -%}

{%- liquid
  assign preview = item.featured_media.preview_image
-%}

<div class="product-item" {{ attrs }}>
  <div class="product-item--image">
    <a href="{{ item.url }}">
      {%- if preview != blank -%}
        {{
          preview
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 1024px) 22vw, 45vw',
            widths: '300,450,600,900',
            alt: preview.alt | default: item.title
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
  </div>

  <div class="product-item--text">
    <div class="title">{{ item.title }}</div>
    <div class="price">
      {%- if item.price_varies -%}
        {{ item.price_min | money }}~
      {%- else -%}
        {{ item.price | money }}
      {%- endif -%}
    </div>
    <div class="description rich-text-area"></div>
  </div>
</div>
